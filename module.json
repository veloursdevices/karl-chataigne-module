        "Bank": {
          "type": "Integer",
          "default": 1,
          "min": 1,
          "max": 99,
          "description": "The KARL page's bank. Values come back for banks 1-4"
        },
        "Encoder": {
          "type": "Integer",
          "default": 1,
          "min": 1,
          "max": 24,
          "description": "1-24, rows left to right, top row first"
        },
        "Value": {
          "type": "Float",
          "default": 0,
          "min": 0,
          "max": 1
        }
      }
    },
